# Copy to .env and run with: uv run --env-file .env ai-alert-triage

# keyword (no LLM, default) | openai | azure
LLM_PROVIDER=keyword

# Model name for OpenAI, or the deployment name for Azure OpenAI.
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Optional: USD per 1M tokens for your model, used for cost in the audit log.
LLM_PRICE_INPUT_PER_MILLION=
LLM_PRICE_OUTPUT_PER_MILLION=

AUDIT_LOG_PATH=logs/llm_audit.jsonl

# Optional: Postgres connection. Without it, alerts are kept in memory only.
# Run `uv run --env-file .env alembic upgrade head` once before starting the app.
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage

# OAuth2/OIDC: access tokens from Okta (or Entra ID) are validated against the JWKS.
# Scopes: alerts:write to submit alerts, alerts:read to query them.
AUTH_ISSUER=https://your-org.okta.com/oauth2/default
AUTH_AUDIENCE=api://ai-alert-triage
AUTH_JWKS_URL=https://your-org.okta.com/oauth2/default/v1/keys
# Local development only: skip token validation.
AUTH_DISABLED=false
