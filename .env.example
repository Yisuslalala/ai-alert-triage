# Copy to .env and run with: uv run --env-file .env ai-alert-triage

# keyword (no LLM, default) | openai | azure
LLM_PROVIDER=keyword

# Model name for OpenAI, or the deployment name for Azure OpenAI.
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# Optional: USD per 1M tokens for your model, used for cost in the audit log.
LLM_PRICE_INPUT_PER_MILLION=
LLM_PRICE_OUTPUT_PER_MILLION=

AUDIT_LOG_PATH=logs/llm_audit.jsonl
